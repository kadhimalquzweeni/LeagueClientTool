<Window x:Class="LeagueClientTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="League Client Tool"
        Width="1240"
        Height="800"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="24,27,20,34">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="L" FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="LEAGUE CLIENT" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="TOOL" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Margin="24,0,0,12" FontSize="10"
                               FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Padding="10,0" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Setter Property="Padding" Value="13,11" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#222735" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#29243D" />
                                                    <Setter Property="Foreground" Value="#C8B7FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="27" FontSize="16"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#292F3D" BorderThickness="0,1,0,0"
                        Padding="20,17">
                    <StackPanel>
                        <TextBlock Text="CLIENT STATUS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Ellipse Width="8" Height="8" Fill="#E5A94B" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ClientStatus}" Margin="9,0,0,0" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,30,38,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,28">\n                <Button DockPanel.Dock="Right" Content="Refresh connection" Command="{Binding RefreshConnectionCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="{Binding PageDescription}" Margin="0,5,0,0"
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#1A1F2B" BorderBrush="#292F3D"
                        BorderThickness="1" CornerRadius="18" Padding="12,7"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#E5A94B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ClientStatus}" Margin="8,0,0,0" FontSize="10"
                                   FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="#211B35" BorderBrush="#44346D" BorderThickness="1"
                                CornerRadius="14" Padding="25" Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="YOUR LEAGUE, YOUR WAY" FontSize="10"
                                               FontWeight="Bold" Foreground="#B9A5F5" />
                                    <TextBlock Text="Welcome to League Client Tool" FontSize="23"
                                               FontWeight="Bold" Margin="0,9,0,5" />
                                    <TextBlock Text="A desktop companion for managing and customising your League client."
                                               FontSize="12" Foreground="#C2B8D9" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="78" Height="78" CornerRadius="18"
                                        Background="#342653" VerticalAlignment="Center">
                                    <TextBlock Text="⚔" FontSize="36" Foreground="#C8B7FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="OVERVIEW" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,12" />

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="19">
                                <StackPanel>
                                    <TextBlock Text="CLIENT CONNECTION" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                                        <Ellipse Width="9" Height="9" Fill="#E5A94B" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ClientStatus}" FontSize="15"
                                                   FontWeight="SemiBold" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConnectionDetails}"
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="19">
                                <StackPanel>
                                    <TextBlock Text="AVAILABLE TOOLS" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="6 planned sections" FontSize="23" FontWeight="Bold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Profile, customisation, friends, client tools and settings."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="GET STARTED" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,12" />
                        <UniformGrid Columns="3">
                            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="01" Foreground="#B9A5F5" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="Connect" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5" />
                                    <TextBlock Text="Detect the running League client and establish a local connection."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="02" Foreground="#B9A5F5" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="Customise" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5" />
                                    <TextBlock Text="Manage profile details, backgrounds, icons and other client options."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="03" Foreground="#B9A5F5" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="Manage" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5" />
                                    <TextBlock Text="Access friend management and useful League client utilities."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="36">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="✦" FontSize="34" Foreground="#B9A5F5"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,14,0,7" />
                        <TextBlock Text="This section is planned and will be implemented in an upcoming milestone."
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
