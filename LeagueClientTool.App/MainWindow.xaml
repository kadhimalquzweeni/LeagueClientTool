<Window x:Class="LeagueClientTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="League Client Tool"
        Width="1280" Height="850" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="24,27,20,34">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="L" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="LEAGUE CLIENT" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="TOOL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Margin="24,0,0,12" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="10,0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Setter Property="Padding" Value="13,11" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#222735" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#29243D" />
                                                    <Setter Property="Foreground" Value="#C8B7FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="27" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#292F3D" BorderThickness="0,1,0,0" Padding="20,17">
                    <StackPanel>
                        <TextBlock Text="CLIENT STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Ellipse Width="8" Height="8" Fill="#8B5CF6" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ClientStatus}" Margin="9,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="36,28,36,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Content="Refresh connection" Command="{Binding RefreshConnectionCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Border DockPanel.Dock="Right" Background="#1A1F2B" BorderBrush="#292F3D" BorderThickness="1" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClientStatus}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="{Binding PageDescription}" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="#211B35" BorderBrush="#44346D" BorderThickness="1" CornerRadius="14" Padding="25" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="YOUR LEAGUE, YOUR WAY" FontSize="10" FontWeight="Bold" Foreground="#B9A5F5" />
                                    <TextBlock Text="Welcome to League Client Tool" FontSize="23" FontWeight="Bold" Margin="0,9,0,5" />
                                    <TextBlock Text="Your desktop companion for managing and customising your League client." FontSize="12" Foreground="#C2B8D9" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="78" Height="78" CornerRadius="18" Background="#342653" VerticalAlignment="Center">
                                    <TextBlock Text="⚔" FontSize="36" Foreground="#C8B7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="19">
                                <StackPanel>
                                    <TextBlock Text="CONNECTED PLAYER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding PlayerName}" FontSize="20" FontWeight="Bold" Margin="0,12,0,4" />
                                    <TextBlock Text="{Binding PlayerLevel}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding PlayerRegion}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="19">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding ClientStatus}" FontSize="20" FontWeight="Bold" Margin="0,12,0,4" />
                                    <TextBlock Text="{Binding ConnectionDetails}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,12" />
                        <UniformGrid Columns="3">
                            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="01" Foreground="#B9A5F5" FontSize="11" FontWeight="Bold" /><TextBlock Text="Profile" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5" /><TextBlock Text="Riot ID, status, visible rank and banner." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0">
                                <StackPanel><TextBlock Text="02" Foreground="#B9A5F5" FontSize="11" FontWeight="Bold" /><TextBlock Text="Customisation" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5" /><TextBlock Text="Profile icons and champion backgrounds." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                                <StackPanel><TextBlock Text="03" Foreground="#B9A5F5" FontSize="11" FontWeight="Bold" /><TextBlock Text="Management" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5" /><TextBlock Text="Friends, challenge tokens and client tools." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsProfileVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="RIOT ID" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding GameNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding TagLineInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Change Riot ID" Command="{Binding ChangeRiotIdCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PROFILE STATUS MESSAGE" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding StatusMessageInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="Update status" Command="{Binding UpdateStatusMessageCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="VISIBLE RANK" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                <UniformGrid Columns="3">
                                    <ComboBox ItemsSource="{Binding QueueOptions}" SelectedItem="{Binding VisibleRankQueue}" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding TierOptions}" SelectedItem="{Binding VisibleRankTier}" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding DivisionOptions}" SelectedItem="{Binding VisibleRankDivision}" />
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Set visible rank" Command="{Binding SetVisibleRankCommand}" Margin="0,0,8,0" />
                                    <Button Content="Clear visible rank" Command="{Binding ClearVisibleRankCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="PROFILE BANNER &amp; CHALLENGE TOKENS" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <Button Content="Set last-rank banner" Command="{Binding SetLastRankBannerCommand}" Margin="0,0,8,8" />
                                    <Button Content="Clear challenge tokens" Click="OnClearChallengeTokensClick" Margin="0,0,8,8" />
                                    <Button Content="Copy first token to all slots" Click="OnCopyFirstChallengeTokenClick" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCustomisationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PROFILE ICON" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Choose one of the classic icon IDs or enter any icon ID manually. Enter 202 for no icon." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ProfileIconIdInput, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Set profile icon" Command="{Binding SetProfileIconCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailableProfileIcons}" Margin="0,16,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#11151D" BorderBrush="#292F3D" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,8">
                                                <StackPanel Width="82">
                                                    <Image Source="{Binding ImageUrl}" Width="64" Height="64" Stretch="Uniform" />
                                                    <TextBlock Text="{Binding IconId}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,5" />
                                                    <Button Content="Set" Padding="8,5"
                                                            Command="{Binding DataContext.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding IconId}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="CHAMPION PROFILE BACKGROUND" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Select a champion to browse their available profile backgrounds." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
                                <ComboBox ItemsSource="{Binding ChampionBackgrounds}" DisplayMemberPath="ChampionName" SelectedItem="{Binding SelectedChampion}" />
                                <TextBlock Text="Skin" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,6" />
                                <ComboBox ItemsSource="{Binding ChampionSkins}" DisplayMemberPath="SkinName" SelectedItem="{Binding SelectedSkin}" />
                                <Image Source="{Binding SelectedSkin.ImageUrl}" Height="190" Stretch="UniformToFill" Margin="0,12,0,8" />
                                <TextBlock Text="{Binding SelectedSkin.ImageUrl, TargetNullValue=Choose a champion and skin}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
                                <Button Content="Apply selected background" Command="{Binding SetProfileBackgroundCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFriendsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FRIEND REQUESTS" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Accept incoming requests or clear all pending requests." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14" />
                                <WrapPanel>
                                    <Button Content="Accept all requests" Click="OnAcceptAllFriendRequestsClick" Margin="0,0,8,8" />
                                    <Button Content="Delete all requests" Click="OnDeleteAllFriendRequestsClick" Margin="0,0,8,8" />
                                    <Button Content="Refresh folders" Command="{Binding LoadFriendGroupsCommand}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="DELETE FRIENDS FROM FOLDER" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="This permanently removes friends in the selected folder from your friends list." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14" />
                                <ComboBox ItemsSource="{Binding FriendGroups}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFriendGroup}" />
                                <Button Content="Delete friends in selected folder" Click="OnDeleteFriendsFromSelectedGroupClick" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsToolsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CUSTOM LCU REQUEST" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Send a request to the local League Client API. Use a path such as /lol-summoner/v1/current-summoner, not a full URL." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding RequestMethods}" SelectedItem="{Binding CustomRequestMethod}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CustomRequestEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Text="JSON body (optional)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,6" />
                                <TextBox Text="{Binding CustomRequestBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110" />
                                <Button Content="Send request" Command="{Binding SendCustomRequestCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding CustomRequestStatus}" FontWeight="Bold" Margin="0,14,0,6" />
                                <TextBox Text="{Binding CustomRequestResponseBody}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="LEAGUE CLIENT UI" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Restart the League client interface without closing the game process." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14" />
                                <Button Content="Restart League UX" Click="OnRestartLeagueUxClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ABOUT LEAGUE CLIENT TOOL" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
                                <TextBlock Text="A native Windows desktop companion for the local League Client API." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="The application only sends requests to the local League client and Riot's public Data Dragon asset service." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="#1A1F2B" BorderBrush="#292F3D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                <TextBlock Text="{Binding OperationMessage}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
