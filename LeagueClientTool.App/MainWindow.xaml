<Window x:Class="LeagueClientTool.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="League Client Tool" Width="1280" Height="850" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI">
<Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#111927" BorderBrush="#263448" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="22,26,18,26">
                <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Left" Margin="0,0,0,15">
                    <TextBlock Text="L" FontSize="25" FontWeight="Black" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="LEAGUE CLIENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" />
                <TextBlock Text="TOOLKIT" FontSize="21" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="Desktop companion" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="22,0,0,12"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Setter Property="Padding" Value="10,10"/>
                            <Setter Property="Margin" Value="10,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="ActiveMark" Background="{StaticResource AccentBrush}" CornerRadius="2" Opacity="0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="17" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#202D40"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="NavBorder" Property="Background" Value="#29364A"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                                            <Setter TargetName="ActiveMark" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
            <Border Grid.Row="2" Background="#182334" BorderBrush="#2A394E" BorderThickness="1" CornerRadius="12" Padding="14" Margin="14,16,14,18">
                <StackPanel>
                    <TextBlock Text="CLIENT CONNECTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding ClientStatus}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding PlayerName}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                    <Button Content="Refresh connection" Command="{Binding RefreshConnectionCommand}" Padding="10,8" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,28,34,22" MaxWidth="1320" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Visibility="{Binding IsPageHeroVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource HeroBackgroundBrush}" BorderBrush="#40C89B3C" BorderThickness="1" CornerRadius="18" Padding="32,28" Margin="0,0,0,22" Effect="{StaticResource PanelShadowEffect}"><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="38" FontWeight="Bold"/><TextBlock Text="{Binding PageDescription}" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><WrapPanel><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="icons"><StackPanel><TextBlock Text="Profile Icon Changer" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Browse available profile icons and set one directly through your local League Client." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="backgrounds"><StackPanel><TextBlock Text="Profile Background Changer" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Browse champions, view their skins, and set a splash art as your profile background." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="status"><StackPanel><TextBlock Text="Profile Status Changer" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Update your League Client status message from the local desktop interface." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="tokens"><StackPanel><TextBlock Text="Challenge Tokens" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Clear selected League Challenge Tokens from your profile banner." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="banner"><StackPanel><TextBlock Text="Profile Banner" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Set your League profile banner accent, including the last-rank banner." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="rank"><StackPanel><TextBlock Text="Visible Rank" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Change the rank displayed in League chat and your friends list." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="client"><StackPanel><TextBlock Text="Client Tools" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Restart the League Client interface if the client UI freezes or stops responding." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="friends"><StackPanel><TextBlock Text="Friend Tools" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Accept or delete League friend requests from a clean local interface." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="riotid"><StackPanel><TextBlock Text="Riot ID Changer" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Change your Riot ID name and tagline using the local League Client API." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button><Button Style="{StaticResource ToolCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="request"><StackPanel><TextBlock Text="Custom LCU Request" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock Text="Send custom requests to the local League Client API using your current lockfile connection." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/></StackPanel></Button></WrapPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsIconsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Manual Icon ID" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Enter a profile icon ID below. Enter 202 for no icon." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="Profile Icon ID" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ProfileIconIdInput, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Set Profile Icon" Command="{Binding SetProfileIconCommand}" IsEnabled="{Binding IsClientConnected}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Separator Margin="0,28,0,28" Background="{StaticResource PanelBorderBrush}" />
                        <TextBlock Text="Profile Icons 50–78" FontSize="32" FontWeight="Black" Margin="0,0,0,8" />
                        <TextBlock Text="Click Set under an icon to apply it to your League profile. These are only visible on websites like OP.GG &amp; U.GG." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding AvailableProfileIcons}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#B3020617" BorderBrush="#4094A3B8" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,16,16">
                                                <StackPanel Width="110">
                                                    <Image Source="{Binding ImageUrl}" Width="72" Height="72" Stretch="Uniform" />
                                                    <TextBlock Text="{Binding IconId, StringFormat='ID: {0}'}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,5" />
                                                    <Button Content="Set" Padding="8,5"
                                                            Command="{Binding DataContext.SetProfileIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding IconId}"
                                                            IsEnabled="{Binding DataContext.IsClientConnected, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBackgroundsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel Visibility="{Binding IsChampionSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
<TextBlock Text="Champion Backgrounds" FontSize="40" FontWeight="Black" Margin="0,0,0,10"/>
<TextBlock Text="Find a champion to browse their available splash art." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,18"/>
<Border Background="#182334" BorderBrush="#34445A" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,20" MaxWidth="560" HorizontalAlignment="Left">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="⌕" FontSize="21" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Column="1" Text="{Binding ChampionSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Padding="2,5" VerticalContentAlignment="Center" ToolTip="Search champions by name"/>
        <Button Grid.Column="2" Content="Clear" Command="{Binding ClearChampionSearchCommand}" Padding="10,5" Margin="10,0,0,0" Background="#29364A" Foreground="{StaticResource SecondaryTextBrush}"/>
    </Grid>
</Border>
<TextBlock Text="No champions match your search. Try another name." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,18" Visibility="{Binding HasNoChampionSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
<ListBox ItemsSource="{Binding FilteredChampionBackgrounds}" SelectedItem="{Binding SelectedChampion}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
<ListBox.Template><ControlTemplate TargetType="{x:Type ListBox}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ItemsPresenter/></Border></ControlTemplate></ListBox.Template>
<ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ChampionCard" Background="#BF0F172A" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChampionCard" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-3"/></Setter.Value></Setter><Setter TargetName="ChampionCard" Property="Effect" Value="{StaticResource PanelShadowEffect}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel Width="260"><Image Source="{Binding ImageUrl}" Height="146" Stretch="UniformToFill"/><TextBlock Text="{Binding ChampionName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,4"/><TextBlock Text="View skins" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
</ListBox></StackPanel>
<StackPanel Visibility="{Binding IsSkinGalleryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
<Button Content="← Back to Champions" Command="{Binding BackToChampionsCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" Background="#2633414D" Foreground="{StaticResource PrimaryTextBrush}"/>
<ItemsControl ItemsSource="{Binding ChampionSkins}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="#BF0F172A" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,16,16"><StackPanel Width="280"><Image Source="{Binding ImageUrl}" Height="158" Stretch="UniformToFill"/><TextBlock Text="{Binding SkinName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,4"/><TextBlock Text="{Binding SkinId, StringFormat='Skin ID: {0}'}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/><Button Content="Set Background" Command="{Binding DataContext.SetProfileBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SkinId}" IsEnabled="{Binding DataContext.IsClientConnected, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Status Message" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Enter the message you want to display on your League profile. Large multiline status messages may not persist after restarting the League Client. This tool saves your text locally so you can quickly reapply it." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Text="New Status Message" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <StackPanel>
                                    <TextBox Text="{Binding StatusMessageInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="5000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="190" Margin="0,0,0,12" />
                                    <Button Content="Update Status Message" Command="{Binding UpdateStatusMessageCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTokensVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="Clear Challenge Tokens" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="This removes the currently selected challenge tokens from your profile banner. It does not delete your challenge progress or earned challenges." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/><Button Content="Clear Challenge Tokens" Click="OnClearChallengeTokensClick" HorizontalAlignment="Left"/></StackPanel></Border><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24"><StackPanel><TextBlock Text="Copy First Token Across" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="This copies the Token on your first Token slot across to your second and third." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/><Button Content="Copy First Token to All Slots" Click="OnCopyFirstChallengeTokenClick" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24"><StackPanel><TextBlock Text="Invisible Banner" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Attempts to apply the invisible profile banner. This only appears invisible if your account has no previous ranked season banner. If you had a previous rank, League may show that rank banner instead." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/><Button Content="Set Invisible Banner" Command="{Binding SetLastRankBannerCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRankVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24"><StackPanel>
<TextBlock Text="Set Visible Rank" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
<TextBlock Text="This changes the rank shown in the friends list only. It does not change your real rank or ranked profile." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
<StackPanel>
<StackPanel Margin="0,0,0,12"><TextBlock Text="Queue" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding QueueOptions}" SelectedItem="{Binding VisibleRankQueue}"/></StackPanel>
<StackPanel Margin="0,0,0,12"><TextBlock Text="Rank" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding TierOptions}" SelectedItem="{Binding VisibleRankTier}"/></StackPanel>
<StackPanel><TextBlock Text="Division" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding DivisionOptions}" SelectedItem="{Binding VisibleRankDivision}"/></StackPanel>
</StackPanel><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Set Visible Rank" Command="{Binding SetVisibleRankCommand}" Margin="0,0,8,0"/><Button Content="Clear Visible Rank" Command="{Binding ClearVisibleRankCommand}"/></StackPanel>
</StackPanel></Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsClientVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Restart League UX" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Restarts the League Client interface by closing LeagueClientUx and LeagueClientUxRender. This can help if the League Client UI is frozen, blank, or not responding." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Text="This does not intentionally close the main League Client process or Riot Client." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Content="Restart League UX" Click="OnRestartLeagueUxClick" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFriendsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Friend Requests" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Accept or delete all pending friend requests in the League Client." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14" />
                                <WrapPanel>
                                    <Button Content="Accept All Friend Requests" Click="OnAcceptAllFriendRequestsClick" Margin="0,0,8,8" />
                                    <Button Content="Delete All Friend Requests" Click="OnDeleteAllFriendRequestsClick" Margin="0,0,8,8" />
                                    
                                </WrapPanel>
                            </StackPanel>
                        </Border><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Delete Friends From Folder" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Deletes every friend inside the selected League Client folder from your friends list. This does not just move them to General." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14" />
                                <TextBlock Text="Friend Folder" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding FriendGroups}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFriendGroup}" />
                                <Button Content="Delete Friends In Selected Folder" Click="OnDeleteFriendsFromSelectedGroupClick" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRiotIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24" Effect="{StaticResource PanelShadowEffect}">
  <StackPanel>
    <TextBlock Text="New Riot ID" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
    <TextBlock Text="Enter the Riot ID name and tagline you want to use. Riot may reject the change if your account is on cooldown, the name is invalid, or the endpoint is unavailable." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="Game Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox Text="{Binding GameNameInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" ToolTip="Example: Hide on bush"/></StackPanel>
      <TextBlock Grid.Column="1" Text="#" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
      <StackPanel Grid.Column="2"><TextBlock Text="Tagline" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox Text="{Binding TagLineInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" ToolTip="Example: KR1"/></StackPanel>
    </Grid>
    <Button Content="Change Riot ID" Command="{Binding ChangeRiotIdCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
  </StackPanel>
</Border>
<Border Visibility="{Binding IsProfileResponseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,18,0,0" Effect="{StaticResource PanelShadowEffect}">
  <StackPanel><TextBlock Text="Response" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="{Binding ProfileResponseStatus}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,10"/><TextBox Text="{Binding ProfileResponseBody}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="180"/></StackPanel>
</Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRequestVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><StackPanel IsEnabled="{Binding IsClientConnected}"><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Request" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Enter a local LCU endpoint. Do not enter the full https://127.0.0.1:port URL." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <StackPanel>
                                    <TextBlock Text="Method" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding RequestMethods}" SelectedItem="{Binding CustomRequestMethod}" Margin="0,0,0,14" />
                                    <TextBlock Text="URL / Endpoint" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding CustomRequestEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Text="Body" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,6" />
                                <TextBox Text="{Binding CustomRequestBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110" />
                                <Button Content="Send Request" Command="{Binding SendCustomRequestCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <TextBlock Text="Response" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,6" /><TextBlock Text="{Binding CustomRequestStatus}" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding CustomRequestResponseBody}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" />
                            </StackPanel>
                        </Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsPrivacyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24"><StackPanel><TextBlock Text="About League Client Tool" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="A native Windows desktop companion for the local League Client API." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="The application sends requests only to the local League client and Riot's public Data Dragon asset service. Your lockfile credentials are used locally and are not uploaded to a remote service." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>
</Grid>
</Grid></Window>